{
    "name": "@whiteeclipse/documentation-builder",
    "version": "0.1.0-alpha.1",
    "description": "Exploratory documentation artifact builder and portable reader for RFC-0005.",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./artifact": {
            "types": "./dist/artifact/index.d.ts",
            "development": "./src/artifact/index.ts",
            "default": "./dist/artifact/index.js"
        },
        "./browser": {
            "types": "./dist/browser/index.d.ts",
            "development": "./src/browser/index.ts",
            "default": "./dist/browser/index.js"
        },
        "./vite": {
            "types": "./dist/vite/index.d.ts",
            "development": "./src/vite/index.ts",
            "default": "./dist/vite/index.js"
        },
        "./vite/client": {
            "types": "./dist/vite/client.d.ts",
            "development": "./src/vite/client.ts",
            "default": "./dist/vite/client.js"
        },
        "./styles.css": "./dist/callouts.css"
    },
    "bin": {
        "documentation-builder": "./dist/cli.js"
    },
    "files": [
        "dist",
        "LICENCE",
        "src"
    ],
    "scripts": {
        "build": "bun run typecheck && bun scripts/build.ts && tsc -p tsconfig.build.json && bun scripts/finalize.ts",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "fflate": "0.8.3",
        "file-type": "22.2.0",
        "github-slugger": "2.0.0",
        "image-size": "2.0.4",
        "it-tar": "6.0.6",
        "mdast-util-to-string": "4.0.0",
        "pdf-lib": "1.17.1",
        "rehype-parse": "9.0.1",
        "rehype-sanitize": "6.0.0",
        "rehype-stringify": "10.0.1",
        "remark-frontmatter": "5.0.0",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "saxes": "6.0.0",
        "unified": "11.0.5",
        "unist-util-visit": "5.2.0"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "@types/hast": "3.0.5",
        "@types/mdast": "4.0.4",
        "typescript": "5.9.3",
        "vite": "8.3.4"
    },
    "peerDependencies": {
        "vite": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "engines": {
        "bun": ">=1.4.0"
    }
}
