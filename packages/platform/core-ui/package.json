{
    "name": "@whiteeclipse/core-ui",
    "version": "0.1.0-alpha.1",
    "private": true,
    "description": "Shared Radix Themes-compatible styles for White Eclipse applications.",
    "license": "MIT",
    "sideEffects": [
        "**/*.css"
    ],
    "type": "module",
    "exports": {
        "./styles.css": "./src/styles.css",
        "./assets/white-eclipse-light.png": "./src/assets/white-eclipse-light.png",
        "./assets/white-eclipse-dark.png": "./src/assets/white-eclipse-dark.png"
    },
    "files": [
        "src",
        "dist/obsidian"
    ],
    "scripts": {
        "build:obsidian": "bun run typecheck && bun scripts/build-obsidian.ts",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.2.0",
        "@fontsource-variable/jetbrains-mono": "^5.2.0",
        "@fontsource-variable/outfit": "^5.2.0"
    },
    "devDependencies": {
        "@types/bun": "1.4.4"
    },
    "peerDependencies": {
        "@radix-ui/themes": "^3.3.0"
    }
}
