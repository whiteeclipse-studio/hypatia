{
    "name": "@whiteeclipse/core-ui",
    "version": "0.1.0-alpha.1",
    "private": true,
    "description": "Shared Radix Themes-compatible styles for White Eclipse applications.",
    "license": "MIT",
    "sideEffects": [
        "**/*.css"
    ],
    "type": "module",
    "exports": {
        "./styles.css": "./src/styles.css",
        "./assets/white-eclipse-light.png": "./src/assets/white-eclipse-light.png",
        "./assets/white-eclipse-dark.png": "./src/assets/white-eclipse-dark.png"
    },
    "files": [
        "src",
        "dist/obsidian"
    ],
    "scripts": {
        "build:obsidian": "bun run typecheck && bun scripts/build-obsidian.ts",
        "lint": "bun --conditions=development run --bun eslint .",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "@fontsource-variable/jetbrains-mono": "5.3.0",
        "@fontsource-variable/outfit": "5.3.0"
    },
    "devDependencies": {
        "@total-typescript/ts-reset": "catalog:types",
        "@types/bun": "catalog:types",
        "@whiteeclipse/toolchain": "workspace:*",
        "eslint": "catalog:tooling"
    },
    "peerDependencies": {
        "@radix-ui/themes": "catalog:ui"
    }
}
