{
    "name": "@whiteeclipse/i18next",
    "version": "0.1.0-alpha.1",
    "private": true,
    "description": "Exploratory React localization and Vite YAML integration for RFC-0004.",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./vite": {
            "types": "./dist/vite/index.d.ts",
            "development": "./src/vite/index.ts",
            "default": "./dist/vite/index.js"
        },
        "./vite/client": {
            "types": "./dist/vite/client.d.ts",
            "development": "./src/vite/client.ts",
            "default": "./dist/vite/client.js"
        },
        "./catalogue": {
            "types": "./dist/catalogue/index.d.ts",
            "development": "./src/catalogue/index.ts",
            "default": "./dist/catalogue/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "lint": "bun --conditions=development run --bun eslint .",
        "test": "bun run build && vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "i18next": "26.5.11",
        "react-i18next": "17.1.9",
        "yaml": "2.9.1"
    },
    "devDependencies": {
        "@total-typescript/ts-reset": "catalog:types",
        "@types/node": "catalog:types",
        "@types/react": "catalog:types",
        "@types/react-dom": "catalog:types",
        "@whiteeclipse/toolchain": "workspace:*",
        "eslint": "catalog:tooling",
        "happy-dom": "21.0.4",
        "react": "catalog:ui",
        "react-dom": "catalog:ui",
        "typescript": "catalog:types",
        "vite": "catalog:build",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "react": "catalog:ui",
        "vite": "catalog:build"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    }
}
