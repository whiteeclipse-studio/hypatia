{
    "name": "@whiteeclipse/i18next",
    "version": "0.1.0-alpha.1",
    "description": "Exploratory React localization and Vite YAML integration for RFC-0004.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/whiteeclipse-studio/hypatia.git",
        "directory": "packages/platform/i18next"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./vite": {
            "types": "./dist/vite/index.d.ts",
            "development": "./dist/vite/index.js",
            "default": "./dist/vite/index.js"
        },
        "./vite/client": {
            "types": "./dist/vite/client.d.ts",
            "development": "./dist/vite/client.js",
            "default": "./dist/vite/client.js"
        },
        "./catalogue": {
            "types": "./dist/catalogue/index.d.ts",
            "development": "./dist/catalogue/index.js",
            "default": "./dist/catalogue/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.json",
        "lint": "bun --conditions=development run --bun eslint .",
        "prepack": "bun run build",
        "test": "bun run build && vitest run src",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "i18next": "26.5.11",
        "react-i18next": "17.1.9",
        "yaml": "2.9.1"
    },
    "devDependencies": {
        "@total-typescript/ts-reset": "catalog:types",
        "@types/node": "catalog:types",
        "@types/react": "catalog:types",
        "@types/react-dom": "catalog:types",
        "@whiteeclipse/toolchain": "workspace:*",
        "eslint": "catalog:tooling",
        "happy-dom": "21.0.4",
        "react": "catalog:ui",
        "react-dom": "catalog:ui",
        "typescript": "catalog:types",
        "vite": "catalog:build",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "react": "catalog:ui",
        "vite": "catalog:build"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "tag": "alpha"
    }
}
