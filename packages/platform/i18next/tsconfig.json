{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["@total-typescript/ts-reset", "node", "vite/client"],
        "noEmit": false,
        "rootDir": "src",
        "outDir": "dist",
        "sourceMap": false,
        "declarationMap": false,
        "rewriteRelativeImportExtensions": true,
        "paths": {
            "@whiteeclipse/i18next": ["./src/index.ts"]
        },
        "moduleDetection": "legacy"
    },
    "include": ["src"]
}
