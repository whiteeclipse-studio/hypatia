{
    "name": "@whiteeclipse/docs-compiler",
    "version": "0.1.0-alpha.2",
    "description": "Hypatia-compatible extensible documentation compiler that produces Unified HAST artifacts.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/whiteeclipse-studio/hypatia.git",
        "directory": "packages/platform/docs-compiler"
    },
    "license": "MIT",
    "author": {
        "name": "White Eclipse",
        "email": "contact@whiteeclipse.fr",
        "url": "https://whiteeclipse.fr/"
    },
    "sideEffects": [
        "./src/polyfills.ts",
        "./dist/polyfills.js"
    ],
    "type": "module",
    "imports": {
        "#compiler-cache-secondary": {
            "browser": "./dist/compiler/cache/indexeddb.js",
            "node": "./dist/compiler/cache/filesystem.js",
            "default": "./dist/compiler/cache/indexeddb.js"
        },
        "#archive-reader-source": {
            "browser": "./dist/plugins/archive-reader/source.js",
            "node": "./dist/plugins/archive-reader/filesystem-source.js",
            "bun": "./dist/plugins/archive-reader/filesystem-source.js",
            "default": "./dist/plugins/archive-reader/source.js"
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./packages/link-resolver": {
            "types": "./dist/plugins/link-resolver/index.d.ts",
            "default": "./dist/plugins/link-resolver/index.js"
        },
        "./packages/markdown-parser": {
            "browser": null,
            "types": "./dist/plugins/markdown-parser/index.d.ts",
            "bun": "./dist/plugins/markdown-parser/index.js",
            "default": null
        },
        "./packages/archive-writer": {
            "browser": null,
            "types": "./dist/plugins/archive-writer/index.d.ts",
            "bun": "./dist/plugins/archive-writer/index.js",
            "default": null
        },
        "./packages/filesystem-loader": {
            "browser": null,
            "types": "./dist/plugins/filesystem-loader/index.d.ts",
            "bun": "./dist/plugins/filesystem-loader/index.js",
            "default": null
        },
        "./packages/archive-reader": {
            "types": "./dist/plugins/archive-reader/index.d.ts",
            "default": "./dist/plugins/archive-reader/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist .cache/build && tsc -p tsconfig.json && cp -R .cache/build/src dist && rm -rf .cache/build",
        "lint": "bun --conditions=development run --bun eslint .",
        "prepack": "bun run build",
        "test": "vitest run src",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@types/hast": "3.0.5",
        "@types/mdast": "4.0.4",
        "@whiteeclipse/async-queue": "workspace:*",
        "@whiteeclipse/cache": "workspace:*",
        "@whiteeclipse/log": "workspace:*",
        "core-js": "3.50.0",
        "hast-util-assert": "4.0.0",
        "rehype": "13.0.2",
        "remark-frontmatter": "5.0.0",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "type-fest": "catalog:types",
        "typescript-event-target": "1.1.2",
        "unified": "11.0.5",
        "unist-util-visit": "5.0.0",
        "zod": "catalog:types",
        "remark-wiki-link": "2.0.1",
        "@r4ai/remark-callout": "0.6.2"
    },
    "devDependencies": {
        "@total-typescript/ts-reset": "catalog:types",
        "@types/bun": "catalog:types",
        "@whiteeclipse/toolchain": "workspace:*",
        "eslint": "catalog:tooling",
        "hast-util-to-text": "4.0.3",
        "typescript": "catalog:types",
        "vitest": "catalog:test"
    },
    "engines": {
        "bun": ">=1.4.0"
    },
    "publishConfig": {
        "access": "public",
        "tag": "alpha"
    },
    "bin": {
        "docs-compiler": "./dist/cli/index.js"
    }
}
