{
    "name": "@whiteeclipse/docs-compiler",
    "version": "0.1.0-alpha.2",
    "description": "Hypatia-compatible extensible documentation compiler that produces Unified HAST artifacts.",
    "license": "MIT",
    "author": {
        "name": "White Eclipse",
        "email": "contact@whiteeclipse.fr",
        "url": "https://whiteeclipse.fr/"
    },
    "sideEffects": [
        "./src/polyfills.ts"
    ],
    "type": "module",
    "imports": {
        "#compiler-cache-secondary": {
            "browser": "./src/compiler/cache/indexeddb.ts",
            "node": "./src/compiler/cache/filesystem.ts",
            "default": "./src/compiler/cache/indexeddb.ts"
        },
        "#archive-reader-source": {
            "browser": "./src/plugins/archive-reader/source.ts",
            "node": "./src/plugins/archive-reader/filesystem-source.ts",
            "bun": "./src/plugins/archive-reader/filesystem-source.ts",
            "default": "./src/plugins/archive-reader/source.ts"
        }
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./packages/link-resolver": {
            "types": "./src/plugins/link-resolver/index.ts",
            "default": "./src/plugins/link-resolver/index.ts"
        },
        "./packages/markdown-parser": {
            "browser": null,
            "types": "./src/plugins/markdown-parser/index.ts",
            "bun": "./src/plugins/markdown-parser/index.ts",
            "default": null
        },
        "./packages/archive-writer": {
            "browser": null,
            "types": "./src/plugins/archive-writer/index.ts",
            "bun": "./src/plugins/archive-writer/index.ts",
            "default": null
        },
        "./packages/filesystem-loader": {
            "browser": null,
            "types": "./src/plugins/filesystem-loader/index.ts",
            "bun": "./src/plugins/filesystem-loader/index.ts",
            "default": null
        },
        "./packages/markdown-parser-plugin": {
            "types": "./src/plugins/markdown-parser-plugin/index.ts",
            "default": "./src/plugins/markdown-parser-plugin/index.ts"
        },
        "./packages/local-repository-plugin": {
            "browser": null,
            "types": "./src/plugins/local-repository-plugin/index.ts",
            "node": {
                "development": "./src/plugins/local-repository-plugin/index.ts",
                "default": "./src/plugins/local-repository-plugin/index.ts"
            },
            "default": null
        },
        "./packages/archive-reader": {
            "types": "./src/plugins/archive-reader/index.ts",
            "default": "./src/plugins/archive-reader/index.ts"
        }
    },
    "files": [
        "dist",
        "src",
        "LICENCE"
    ],
    "scripts": {
        "lint": "bun --conditions=development run --bun eslint .",
        "test": "vitest run src",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@types/hast": "3.0.5",
        "@types/mdast": "4.0.4",
        "@whiteeclipse/async-queue": "workspace:*",
        "@whiteeclipse/cache": "workspace:*",
        "@whiteeclipse/log": "workspace:*",
        "core-js": "3.50.0",
        "hast-util-assert": "4.0.0",
        "rehype": "13.0.2",
        "remark-frontmatter": "5.0.0",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "type-fest": "catalog:types",
        "typescript-event-target": "1.1.2",
        "unified": "11.0.5",
        "unist-util-visit": "5.0.0",
        "zod": "catalog:types"
    },
    "devDependencies": {
        "@r4ai/remark-callout": "0.6.2",
        "@total-typescript/ts-reset": "catalog:types",
        "@types/bun": "catalog:types",
        "@whiteeclipse/toolchain": "workspace:*",
        "eslint": "catalog:tooling",
        "hast-util-to-text": "4.0.3",
        "remark-wiki-link": "2.0.1",
        "typescript": "catalog:types",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@r4ai/remark-callout": "0.6.2",
        "remark-wiki-link": "2.0.1"
    },
    "peerDependenciesMeta": {
        "@r4ai/remark-callout": {
            "optional": true
        },
        "remark-wiki-link": {
            "optional": true
        }
    },
    "engines": {
        "bun": ">=1.4.0"
    }
}
