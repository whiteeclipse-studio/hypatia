{
    "name": "@whiteeclipse/log",
    "version": "0.1.0-alpha.1",
    "description": "Exploratory typed LogTape configuration builders and sink factories.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/whiteeclipse-studio/hypatia.git",
        "directory": "packages/libraries/log"
    },
    "license": "MIT",
    "sideEffects": [
        "./src/default.ts",
        "./dist/default.js"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./default": {
            "types": "./dist/default.d.ts",
            "development": "./dist/default.js",
            "default": "./dist/default.js"
        },
        "./sink/console": {
            "types": "./dist/configuration/factory/sink/console/index.d.ts",
            "development": "./dist/configuration/factory/sink/console/index.js",
            "default": "./dist/configuration/factory/sink/console/index.js"
        },
        "./sink/json": {
            "types": "./dist/configuration/factory/sink/json/index.d.ts",
            "development": "./dist/configuration/factory/sink/json/index.js",
            "default": "./dist/configuration/factory/sink/json/index.js"
        },
        "./sink/sentry": {
            "types": "./dist/configuration/factory/sink/sentry/index.d.ts",
            "development": "./dist/configuration/factory/sink/sentry/index.js",
            "default": "./dist/configuration/factory/sink/sentry/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.json",
        "lint": "bun --conditions=development run --bun eslint .",
        "prepack": "bun run build",
        "test": "vitest run src",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@logtape/logtape": "2.3.4",
        "@logtape/pretty": "2.3.4"
    },
    "devDependencies": {
        "@logtape/sentry": "2.3.4",
        "@total-typescript/ts-reset": "catalog:types",
        "@types/bun": "catalog:types",
        "@types/node": "catalog:types",
        "@whiteeclipse/toolchain": "workspace:*",
        "eslint": "catalog:tooling",
        "typescript": "catalog:types",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@logtape/sentry": "2.3.4"
    },
    "peerDependenciesMeta": {
        "@logtape/sentry": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "tag": "alpha"
    }
}
