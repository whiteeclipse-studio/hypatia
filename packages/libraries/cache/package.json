{
    "name": "@whiteeclipse/cache",
    "version": "0.1.0-alpha.1",
    "description": "Exploratory byte-oriented cache contracts and filesystem backend work in progress.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/whiteeclipse-studio/hypatia.git",
        "directory": "packages/libraries/cache"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./memory": {
            "types": "./dist/adapters/memory.d.ts",
            "development": "./dist/adapters/memory.js",
            "default": "./dist/adapters/memory.js"
        },
        "./indexeddb": {
            "types": "./dist/adapters/indexeddb.d.ts",
            "development": "./dist/adapters/indexeddb.js",
            "default": "./dist/adapters/indexeddb.js"
        },
        "./aggregate": {
            "types": "./dist/adapters/aggregate.d.ts",
            "development": "./dist/adapters/aggregate.js",
            "default": "./dist/adapters/aggregate.js"
        },
        "./reference-counted": {
            "types": "./dist/adapters/reference-counted.d.ts",
            "development": "./dist/adapters/reference-counted.js",
            "default": "./dist/adapters/reference-counted.js"
        },
        "./filesystem": {
            "browser": null,
            "types": "./dist/adapters/filesystem.d.ts",
            "node": {
                "development": "./dist/adapters/filesystem.js",
                "default": "./dist/adapters/filesystem.js"
            },
            "default": null
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENCE"
    ],
    "scripts": {
        "build": "bun ../../../scripts/build-package.ts",
        "lint": "bun --conditions=development run --bun eslint .",
        "prepack": "bun run build",
        "test": "vitest run src",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@whiteeclipse/async-queue": "workspace:*",
        "@whiteeclipse/log": "workspace:*",
        "idb": "8.0.4"
    },
    "devDependencies": {
        "@total-typescript/ts-reset": "catalog:types",
        "@types/node": "catalog:types",
        "@whiteeclipse/toolchain": "workspace:*",
        "eslint": "catalog:tooling",
        "fake-indexeddb": "6.2.6",
        "typescript": "catalog:types",
        "vite": "catalog:build",
        "vitest": "catalog:test",
        "zod": "catalog:types"
    },
    "peerDependencies": {
        "zod": "catalog:types"
    },
    "peerDependenciesMeta": {
        "zod": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "tag": "alpha"
    }
}
