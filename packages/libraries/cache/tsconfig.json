{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["@total-typescript/ts-reset", "node"],
        "noEmit": false,
        "rootDir": "src",
        "outDir": "dist",
        "sourceMap": false,
        "declarationMap": false,
        "rewriteRelativeImportExtensions": true,
        "paths": {
            "@whiteeclipse/cache": ["./src/index.ts"],
            "@whiteeclipse/cache/*": ["./src/adapters/*.ts"]
        }
    },
    "include": ["src"]
}
