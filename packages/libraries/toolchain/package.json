{
    "name": "@whiteeclipse/toolchain",
    "version": "0.1.0-alpha.1",
    "description": "Shared ESLint and Prettier configuration of White Eclipse.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/whiteeclipse-studio/hypatia.git",
        "directory": "packages/libraries/toolchain"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        "./eslint": {
            "types": "./dist/eslint/index.d.ts",
            "development": "./dist/eslint/index.js",
            "default": "./dist/eslint/index.js"
        },
        "./prettier": {
            "types": "./dist/prettier.d.ts",
            "development": "./dist/prettier.js",
            "default": "./dist/prettier.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.json",
        "lint": "bun --conditions=development run --bun eslint .",
        "prepack": "bun run build",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@eslint/js": "10.0.1",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-jsdoc": "65.4.2",
        "globals": "17.13.0",
        "prettier-plugin-packagejson": "3.0.3",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "8.72.0"
    },
    "devDependencies": {
        "@total-typescript/ts-reset": "catalog:types",
        "eslint": "catalog:tooling"
    },
    "peerDependencies": {
        "eslint": "catalog:tooling",
        "prettier": "catalog:tooling",
        "typescript": "catalog:types"
    },
    "publishConfig": {
        "access": "public",
        "tag": "alpha"
    }
}
