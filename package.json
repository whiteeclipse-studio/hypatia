{
    "name": "hypatia",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*/*"
    ],
    "scripts": {
        "build:packages": "bun run --filter \"./packages/*/*\" build",
        "lint": "bun --conditions=development run --bun eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit && bun run --filter \"./packages/*/*\" typecheck"
    },
    "devDependencies": {
        "@total-typescript/ts-reset": "catalog:types",
        "@types/bun": "catalog:types",
        "@types/node": "catalog:types",
        "@whiteeclipse/docs-compiler": "workspace:*",
        "@whiteeclipse/toolchain": "workspace:*",
        "eslint": "catalog:tooling",
        "prettier": "catalog:tooling",
        "typescript": "catalog:types"
    },
    "catalogs": {
        "types": {
            "@total-typescript/ts-reset": "0.6.1",
            "@types/bun": "1.4.4",
            "@types/node": "26.6.5",
            "@types/react": "19.3.0",
            "@types/react-dom": "19.3.0",
            "type-fest": "5.10.0",
            "typescript": "6.0.3",
            "zod": "4.6.7"
        },
        "build": {
            "vite": "8.3.5"
        },
        "test": {
            "vitest": "5.0.5"
        },
        "tooling": {
            "eslint": "10.13.0",
            "prettier": "3.9.10"
        },
        "ui": {
            "@radix-ui/themes": "3.3.0",
            "react": "19.3.1",
            "react-dom": "19.3.1"
        }
    }
}
