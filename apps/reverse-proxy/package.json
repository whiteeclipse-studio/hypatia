{
    "name": "@whiteeclipse/reverse-proxy",
    "version": "2026.1.0-alpha.1",
    "private": true,
    "description": "GitHub release archive proxy for browser documentation updates.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "wrangler deploy --dry-run --outdir dist",
        "deploy": "wrangler deploy",
        "dev": "wrangler dev",
        "lint": "bun --conditions=development run --bun eslint .",
        "test": "bun test src",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "devDependencies": {
        "@types/bun": "catalog:types",
        "@whiteeclipse/toolchain": "workspace:*",
        "eslint": "catalog:tooling",
        "typescript": "catalog:types",
        "wrangler": "4.154.0"
    }
}
