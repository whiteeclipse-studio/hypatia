{
    "name": "@whiteeclipse/storybook",
    "version": "0.1.0-alpha.1",
    "private": true,
    "description": "Shared workspace for exploratory layout and component proposals.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "bun run typecheck && storybook build --disable-telemetry",
        "dev": "bun run --cwd ../../packages/platform/i18next build && storybook dev --host 0.0.0.0 -p 20101 --exact-port --no-open --disable-telemetry",
        "lint": "bun --conditions=development run --bun eslint .",
        "typecheck": "bun run --cwd ../../packages/platform/i18next build && tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@radix-ui/themes": "catalog:ui",
        "@whiteeclipse/core-ui": "workspace:*",
        "@whiteeclipse/i18next": "workspace:*",
        "@whiteeclipse/log": "workspace:*",
        "react": "catalog:ui",
        "react-dom": "catalog:ui"
    },
    "devDependencies": {
        "@storybook/addon-a11y": "10.6.2",
        "@storybook/react-vite": "10.6.2",
        "@tailwindcss/vite": "4.3.3",
        "@total-typescript/ts-reset": "catalog:types",
        "@types/node": "catalog:types",
        "@types/react": "catalog:types",
        "@types/react-dom": "catalog:types",
        "@whiteeclipse/toolchain": "workspace:*",
        "eslint": "catalog:tooling",
        "storybook": "10.6.2",
        "tailwindcss": "4.3.3",
        "typescript": "catalog:types",
        "vite": "catalog:build"
    }
}
