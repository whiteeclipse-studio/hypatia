{
    "name": "@whiteeclipse/documentation",
    "version": "2026.1.0-alpha.1",
    "private": true,
    "description": "Exploratory documentation website scaffold under draft RFC-0001 and RFC-0002.",
    "type": "module",
    "exports": {
        "./build-output": "./src/server/scripts/output.ts"
    },
    "scripts": {
        "build": "bun run typecheck && NODE_ENV=production bun src/server/scripts/build.ts",
        "build:static": "bun run build",
        "dev": "bun --watch src/server/development.ts",
        "preview": "bun run start",
        "preview:static": "bun --bun vite preview --config src/server/config/vite.config.ts --outDir dist/client --host 127.0.0.1 --port 4174 --strictPort",
        "start": "NODE_ENV=production bun src/server/index.ts",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@hono/node-server": "2.1.5",
        "@whiteeclipse/core-ui": "workspace:*",
        "@whiteeclipse/i18next": "workspace:*",
        "github-slugger": "2.0.0",
        "hast-util-to-string": "3.0.1",
        "hono": "4.13.13",
        "mdast-util-to-string": "4.0.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-i18next": "17.1.0",
        "rehype-parse": "9.0.1",
        "rehype-sanitize": "6.0.0",
        "rehype-stringify": "10.0.1",
        "remark-frontmatter": "5.0.0",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "unified": "11.0.5",
        "unist-util-visit": "5.1.0"
    },
    "devDependencies": {
        "@types/bun": "1.4.3",
        "@types/hast": "3.0.5",
        "@types/mdast": "4.0.4",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "typescript": "~5.9.3",
        "vite": "8.3.4"
    }
}
