{
    "name": "@whiteeclipse/website",
    "version": "2026.1.0-alpha.1",
    "private": true,
    "description": "Exploratory White Eclipse documentation website.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "bun run typecheck && bun scripts/build.ts",
        "build:artifact": "documentation-builder build ../.. --out ./artifacts/hypatia.tar.gz",
        "dev": "bun run --bun vite --host 0.0.0.0 --port 20100 --strictPort",
        "preview": "bun run --bun vite preview --host 0.0.0.0 --port 20100 --strictPort",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@radix-ui/themes": "3.3.0",
        "@whiteeclipse/core-ui": "workspace:*",
        "@whiteeclipse/documentation-builder": "workspace:*",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "rehype-parse": "9.0.1",
        "unified": "11.0.5"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.3",
        "@types/hast": "3.0.5",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "tailwindcss": "4.3.3",
        "typescript": "~5.9.3",
        "vite": "8.3.4"
    },
    "engines": {
        "bun": ">=1.4.0"
    }
}
