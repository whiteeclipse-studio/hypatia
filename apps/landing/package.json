{
    "name": "@whiteeclipse/landing",
    "version": "2026.1.0-alpha.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun run typecheck && NODE_ENV=production bun src/server/scripts/build.ts",
        "build:static": "bun run build --static",
        "dev": "bun --watch src/server/development.ts",
        "preview": "bun run start",
        "preview:static": "bun --bun vite preview --config src/server/config/vite.config.ts --outDir dist/client --host 127.0.0.1",
        "start": "NODE_ENV=production bun src/server/index.ts",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-regular-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-fontawesome": "^3.5.0",
        "@hono/node-server": "2.1.5",
        "@whiteeclipse/core-ui": "workspace:*",
        "@whiteeclipse/i18next": "workspace:*",
        "hono": "4.13.13",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-i18next": "17.1.0"
    },
    "devDependencies": {
        "@types/bun": "1.4.3",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "typescript": "~5.9.3",
        "vite": "8.3.4"
    }
}
